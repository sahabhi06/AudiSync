<Window x:Class="AudiSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudiSync" Width="750"
        SizeToContent="Height"
        MinHeight="300"
        MaxHeight="950">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select Output Devices" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray" FontSize="12">
            Check the devices you want to sync. If audio sounds out of sync between devices, use the − / + buttons to delay the earlier-sounding device until they line up. Play a metronome or clapping sound for the clearest test.
        </TextBlock>

        <ListBox x:Name="DeviceList" Grid.Row="2" MaxHeight="450" VerticalAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RefreshBtn" Content="Refresh" Width="100" Height="30" Click="Refresh_Click"/>
            <Button x:Name="StartBtn" Content="Start Sync" Width="100" Height="30" Margin="10,0,0,0" Click="Start_Click"/>
            <Button x:Name="StopBtn" Content="Stop" Width="100" Height="30" Margin="10,0,0,0" Click="Stop_Click" IsEnabled="False"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" Text="Status: Idle" Margin="0,15,0,0" FontStyle="Italic"/>
    </Grid>
</Window>