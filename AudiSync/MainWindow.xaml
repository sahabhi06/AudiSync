<Window x:Class="AudiSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudiSync" Height="450" Width="500">
    <StackPanel Margin="15">
        <TextBlock Text="Select Output Devices" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <ListBox x:Name="DeviceList" Height="220"/>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RefreshBtn" Content="Refresh" Width="100" Height="30" Click="Refresh_Click"/>
            <Button x:Name="StartBtn" Content="Start Sync" Width="100" Height="30" Margin="10,0,0,0" Click="Start_Click"/>
            <Button x:Name="StopBtn" Content="Stop" Width="100" Height="30" Margin="10,0,0,0" Click="Stop_Click" IsEnabled="False"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Text="Status: Idle" Margin="0,15,0,0" FontStyle="Italic"/>
    </StackPanel>
</Window>